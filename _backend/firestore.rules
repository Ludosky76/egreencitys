rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = comptes autorisés (à ajuster). L'email vient du token d'auth Firebase.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in ['egreencitys@gmail.com', 'ludosky.loic@gmail.com', 'melanie.clery@gmail.com'];
    }

    // LEADS (capture panier / devis) : création ouverte au public, lecture réservée admin.
    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // COMMANDES : écrites UNIQUEMENT par la Cloud Function (Admin SDK, qui contourne
    // les règles). Personne d'autre ne peut écrire. Lecture réservée admin.
    match /orders/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PROFILS / commandes des clients connectés (module compte existant).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
